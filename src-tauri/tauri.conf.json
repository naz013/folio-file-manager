{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Folio",
  "version": "1.0.1",
  "identifier": "app.folio.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Folio",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM3M0U2NzNBMTE2MTg3MjMKUldRamgyRVJPbWMreDZpcDczVnlMcWtZTnpVaTlYQXptNXF4anhnS3F1SXZYVHlRQkwvTmNMZFoK",
      "endpoints": [
        "https://github.com/naz013/folio-file-manager/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "A lightweight, beautiful file manager",
    "longDescription": "Folio is a fast file manager with tabs, two panes, tags, Quick Look previews and safe cleanup. Deleted files go to the Trash and can be brought back.",
    "copyright": "Folio contributors",
    "license": "AGPL-3.0-only",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true
    },
    "linux": {
      "deb": {
        "section": "utils",
        "recommends": ["xdg-utils", "webp-pixbuf-loader"]
      },
      "rpm": {
        "recommends": ["xdg-utils", "webp-pixbuf-loader"]
      }
    },
    "resources": {
      "resources/THIRD-PARTY-LICENSES.txt": "THIRD-PARTY-LICENSES.txt",
      "resources/plugins/": "plugins/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
